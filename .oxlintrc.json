{
 "$schema": "./node_modules/oxlint/configuration_schema.json",
 "options": {
  "typeAware": true,
  "respectEslintDisableDirectives": false
 },
 "plugins": [
  "eslint",
  "typescript",
  "unicorn",
  "oxc",
  "react",
  "vitest",
  "jsx-a11y"
 ],
 "ignorePatterns": [
  "**/dist/**",
  "**/node_modules/**",
  "**/*.gen.ts",
  "**/worker-configuration.d.ts",
  "GitHub/**",
  "scratch/**",
  "packages/whiteboard-client/src/overrides/**",
  "apps/web/src/overrides/**",
  "**/.cloudflare/**"
 ],
 "categories": {
  "correctness": "error"
 },
 "jsPlugins": [
  "@tanstack/eslint-plugin-query",
  "@tanstack/eslint-plugin-router",
  "@stylexjs/eslint-plugin",
  "eslint-plugin-drizzle"
 ],
 "rules": {
  "typescript/await-thenable": "error",
  "typescript/no-floating-promises": "warn",
  "typescript/no-misused-promises": "warn",
  "typescript/no-misused-spread": "warn",
  "typescript/restrict-template-expressions": "warn",
  "typescript/no-unnecessary-type-assertion": "warn",
  "typescript/no-base-to-string": "off",
  "typescript/no-duplicate-type-constituents": "off",
  "typescript/no-meaningless-void-operator": "off",
  "typescript/no-redundant-type-constituents": "off",
  "typescript/no-useless-default-assignment": "off",
  "typescript/require-array-sort-compare": "off",
  "typescript/unbound-method": "off",
  "no-control-regex": "off",
  "no-useless-escape": "off",
  "react/rules-of-hooks": "error",
  "react/exhaustive-deps": "warn",
  "react/error-boundaries": "error",
  "react/globals": "error",
  "react/immutability": "error",
  "react/incompatible-library": "error",
  "react/preserve-manual-memoization": "error",
  "react/purity": "error",
  "react/refs": "error",
  "react/set-state-in-effect": "off",
  "react/set-state-in-render": "error",
  "react/static-components": "error",
  "react/unsupported-syntax": "error",
  "react/use-memo": "error",
  "react/void-use-memo": "error",
  "jsx-a11y/no-autofocus": "off",
  "jsx-a11y/prefer-tag-over-role": "off",
  "@tanstack/query/exhaustive-deps": "error",
  "@tanstack/query/no-rest-destructuring": "warn",
  "@tanstack/query/stable-query-client": "error",
  "@tanstack/query/no-unstable-deps": "error",
  "@tanstack/query/infinite-query-property-order": "error",
  "@tanstack/query/no-void-query-fn": "error",
  "@tanstack/query/mutation-property-order": "error",
  "@tanstack/router/create-route-property-order": "warn",
  "@tanstack/router/route-param-names": "error",
  "drizzle/enforce-delete-with-where": [
   "error",
   {
    "drizzleObjectName": [
     "db",
     "tx"
    ]
   }
  ],
  "drizzle/enforce-update-with-where": [
   "error",
   {
    "drizzleObjectName": [
     "db",
     "tx"
    ]
   }
  ]
 },
 "overrides": [
  {
   "files": [
    "**/*.test.*"
   ],
   "rules": {
    "vitest/no-commented-out-tests": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-import-node-test": "error",
    "vitest/no-interpolation-in-snapshots": "error",
    "vitest/no-mocks-import": "error",
    "vitest/no-unneeded-async-expect-function": "error",
    "vitest/prefer-called-exactly-once-with": "error",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "react/globals": "off"
   }
  },
  {
   "files": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "packages/whiteboard-client/src/**/*.ts",
    "packages/whiteboard-client/src/**/*.tsx"
   ],
   "rules": {
    "@stylexjs/valid-styles": "error",
    "@stylexjs/no-unused": "error",
    "@stylexjs/no-conflicting-props": "error",
    "@stylexjs/valid-shorthands": "error",
    "@stylexjs/enforce-extension": "error",
    "@stylexjs/no-legacy-contextual-styles": "error",
    "@stylexjs/no-lookahead-selectors": "error",
    "@stylexjs/no-nonstandard-styles": "error"
   }
  },
  {
   "files": [
    "apps/web/src/modules/meetings/client/recorder/recorder-audio.tsx"
   ],
   "rules": {
    "jsx-a11y/media-has-caption": "off"
   }
  }
 ]
}
