# Copy to .env to run the agent against the local stack (`pnpm dev` in this
# package). Production nodes get these from infra/ops/node/compose.yaml.

# The local LiveKit apps/web/scripts/setup-livekit.mjs starts from
# infra/dev/livekit.dev.yaml. Plain ws:// is accepted on loopback only.
LIVEKIT_URL=ws://127.0.0.1:27880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Where finished transcripts are delivered: the web dev server.
APP_URL=http://localhost:3000

# Must name a key in the web app's TRANSCRIPTION_INTERNAL_KEYS (apps/web/.dev.vars).
TRANSCRIPTION_INTERNAL_KEY_ID=agent-dev
TRANSCRIPTION_INTERNAL_SECRET=generate-at-least-32-random-characters

# Required: the agent transcribes through Deepgram.
DEEPGRAM_API_KEY=
