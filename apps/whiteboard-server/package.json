    "@tldraw/sync-core": "catalog:",
    "@tldraw/tlschema": "catalog:",
    "@tldraw/utils": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "aws4fetch": "catalog:",
    "valibot": "catalog:",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
