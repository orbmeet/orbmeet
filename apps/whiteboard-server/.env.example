NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# This node's keyrings, the same as its entry in the Worker's NODES ("jwt",
# "command", "callback"): the Worker signs tokens with WHITEBOARD_JWT_KEYS and
# commands with WHITEBOARD_COMMAND_KEYS; this server signs its calls to the
# Worker with WHITEBOARD_CALLBACK_KEYS. The first key in each map signs, every
# key verifies.
WHITEBOARD_JWT_KEYS={"dev":"local-whiteboard-jwt-signing-key-change-me-0001"}
WHITEBOARD_COMMAND_KEYS={"dev":"local-whiteboard-command-key-change-me-0001"}
WHITEBOARD_CALLBACK_KEYS={"dev":"local-whiteboard-callback-key-change-me-0001"}

# Boards are stored in R2. In development, leave these empty to keep boards in
# DATA_DIR/.objects instead.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=

# The board assistant: <provider>/<model id> (google or anthropic) and that
# provider's API key, the same AI_API_KEY the web app uses. Leave both empty
# to run without the assistant.
ASSISTANT_MODEL=
AI_API_KEY=
