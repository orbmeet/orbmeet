    "@orbmeet/public-api-contract": "workspace:*",
    "@orbmeet/ui": "workspace:*",
    "@orbmeet/whiteboard-client": "workspace:*",
    "@orbmeet/whiteboard-core": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "14.0.3",
