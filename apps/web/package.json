{
  "name": "@orbmeet/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "preview": "vite preview",
    "e2e": "node e2e/run.ts",
    "types": "cf workers types",
    "typecheck": "pnpm types && tsc --noEmit && tsc -p service-worker/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.d1.config.ts",
    "deploy": "pnpm -C ../.. run check && pnpm run migrate && cf deploy --prebuilt",
    "migrate": "cf d1 migrations apply \"$(node -p \"require('./cloudflare.deploy.json').databaseId\")\" --dir ../../packages/db/drizzle/migrations --pattern '../../packages/db/drizzle/migrations/*/migration.sql'"
  },
