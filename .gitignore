# ── Package stores ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
.cloudflare/
.wrangler/
# Regenerated by `cf dev`'s wrangler delegate (code-runner keeps its runtime
# types from @cloudflare/workers-types instead).
apps/code-runner/worker-configuration.d.ts
.tanstack/
*.tsbuildinfo

# ── Generated files (recreated by scripts before dev/build) ──────────────────
apps/web/public/wasm/
apps/web/public/wb-assets/

# ── Secrets — never commit ────────────────────────────────────────────────────
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
infra/ops/node/.runtime/
infra/ops/secrets.age.next
*.pem
*.key
credentials.json

# ── Production config — contains real D1 IDs, Paddle tokens, domain routing ──
apps/web/cloudflare.deploy.json

apps/web/worker-configuration.d.ts

# ── Local runtime data ─────────────────────────────────────────────────────────
# Whiteboard sync DBs, analytics tokens, and other machine-local material
# that must never be committed.
.local/

# ── Local databases ───────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Local tooling ─────────────────────────────────────────────────────────────
.amp/
.factory/
.scratch/

# ── Local dev references (never commit) ───────────────────────────────────────
docs/*

# ── External checkouts (unrelated to this app's build, e.g. tldraw source) ────
GitHub/

# ── Private addons — never commit ────────────────────────────────────────────
packages/whiteboard-client/src/overrides/

# ── AI coding instructions (personal, not public) ────────────────────────────
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.github/copilot-instructions.md
# Agent working notes and transcripts. Local artifacts, like .claude/ — not
# something to publish, and not something a `git add -A` should stage.
.agents/
# Conversation exports (`/export`), wherever they were saved:
# 2026-10-08-010705-<topic>.txt
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt

# ── Root-level scratch files ──────────────────────────────────────────────────
/*.md
!/README.md
/*.txt
/*.html
/*.sql
/*.json
# ...but keep root project manifests that match the broad globs above
!package.json
!pnpm-lock.yaml
!tsconfig*.json
!/.oxlintrc.json
REPORTS/
conversation.md
response.md

# ── Production infrastructure — kept on the operator's machine ───────────────
infra/ops/inventory.json
infra/ops/secrets.age
infra/ops/age-recipients.txt
